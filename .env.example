ENVIRONMENT=development
WEB_PORT=8088
PUBLIC_BASE_URL=http://localhost
DEFAULT_TIMEZONE=Asia/Shanghai

DATABASE_URL=postgresql+asyncpg://synapsekb:change-me@postgres:5432/synapsekb
# API/MCP 默认使用连接池；Dramatiq Worker 由 Compose 覆盖为 null，避免跨事件循环复用 asyncpg 连接。
DATABASE_POOL_MODE=pooled
POSTGRES_DB=synapsekb
POSTGRES_USER=synapsekb
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0

# 生产环境必须更换。JWT 至少 32 字符。
JWT_SECRET=development-only-change-me-at-least-32-bytes
# 生成方式：openssl rand -base64 32 | tr '+/' '-_'；必须解码为 32 字节。
CREDENTIAL_MASTER_KEY=

CORS_ORIGINS=["http://localhost","http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api","mcp-server"]
MCP_ALLOWED_ORIGINS=["http://localhost"]
MCP_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
# Compose 中 API 只接受 Nginx 内网流量，因此可安全读取 Nginx 覆盖后的 X-Real-IP。
TRUST_PROXY_HEADERS=true

# development 可用 local；production 必须选择 s3/oss/cos。
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/storage
STORAGE_BUCKET=synapsekb
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

MAX_UPLOAD_BYTES=209715200
ALLOWED_URL_PORTS=[80,443]
EMBEDDING_DIMENSIONS=1536
WIKI_HEALTH_SCHEDULER_POLL_SECONDS=300

PADDLEOCR_BASE_URL=
PADDLEOCR_API_KEY=
PADDLEOCR_MAX_CONCURRENCY=2

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
